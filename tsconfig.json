{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "packages/*/test/**/*.ts",
    "packages/*/test/**/*.tsx",
    "packages/*/e2e/**/*.ts",
    "test/**/*.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ],
  // Fixtures for the server-only walk, which import through a site's "@/" alias that this repository has no root for.
  "exclude": ["packages/site/test/server-only"]
}
