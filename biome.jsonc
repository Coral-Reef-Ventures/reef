{
  // .jsonc, not .json: Biome accepts `//` comments in a biome.json too, but a comment there silently drops the
  // members that follow it in that object, so the config reads as applied and is not. The products learned this.
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!!**/node_modules",
      "!!**/dist",
      // Generated by the products' theme packages and copied here as the expected output; formatting a fixture
      // would break the byte comparison it exists for.
      "!packages/theme/test/fixtures/**/theme.css"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noExcessiveCognitiveComplexity": "warn"
      },
      "style": {
        "noDefaultExport": "error",
        "useConsistentTypeDefinitions": { "level": "error", "options": { "style": "type" } },
        "useFilenamingConvention": {
          "level": "error",
          "options": { "filenameCases": ["kebab-case", "export"] }
        },
        "useNamingConvention": {
          "level": "error",
          "options": {
            "strictCase": false,
            // Object keys may be data: HTTP headers, file extensions, brand color names such as ink-soft.
            "conventions": [
              {
                "selector": { "kind": "objectLiteralProperty" },
                "formats": ["camelCase", "CONSTANT_CASE", "PascalCase"]
              }
            ]
          }
        },
        "useImportType": "error"
      },
      "suspicious": {
        "noConsole": { "level": "warn", "options": { "allow": ["warn", "error"] } }
      }
    }
  },
  "overrides": [
    {
      // The command-line tools and the smoke test report to the console.
      "includes": ["packages/site-tools/src/**", "test/consumer/**"],
      "linter": {
        "rules": {
          "suspicious": { "noConsole": "off" }
        }
      }
    },
    {
      // Vitest discovers its config by convention and requires a default export, and a CSS module's type
      // declaration describes a bundler that hands class names over as one.
      "includes": ["**/vitest.config.ts", "**/*.d.ts"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      // React components are named after their export.
      "includes": ["**/*.tsx"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": { "filenameCases": ["kebab-case", "PascalCase", "export"] }
            }
          }
        }
      }
    }
  ]
}
