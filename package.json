{
  "name": "reef",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "Shared packages for the Coral Reef family: the public-site shell, its tools, the Mantine theme builder, and the contact-form handler.",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm --filter @coralreefventures/site-tools run build",
    "release": "pnpm --filter @coralreefventures/theme --filter @coralreefventures/contact --filter @coralreefventures/site-tools --filter @coralreefventures/site publish",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "smoke:packed": "node test/consumer/smoke.ts --packed",
    "smoke:registry": "node test/consumer/smoke.ts --registry"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Coral-Reef-Ventures/reef.git"
  },
  "homepage": "https://coralreefventures.com/",
  "license": "MIT"
}
